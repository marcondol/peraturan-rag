# Salin ke .env lalu isi. JANGAN commit .env (sudah di .gitignore).
# LLM: pilih SATU backend dulu (vllm ATAU openrouter ATAU gemini).
# Malam ini: openrouter — satu key untuk banyak model, termasuk Gemini.
LLM_BACKEND=demo
LLM_MODEL=
VLLM_BASE_URL=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Model default bila LLM_MODEL kosong: openrouter -> google/gemini-2.5-flash
# Embedding untuk pgvector (model 1536-dimensi, default di bawah):
EMBEDDING_MODEL=openai/text-embedding-3-small
# Harga per 1M token (USD) dari provider-mu — untuk cost/request.
# Kosong = 0 = biaya tidak diketahui (bukan nol).
LLM_PRICE_PROMPT_PER_1M=0
LLM_PRICE_COMPLETION_PER_1M=0
# Langfuse self-hosted (isi setelah infra/langfuse jalan).
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# OpenTelemetry Collector (opsional, Minggu 1).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Retrieval: kosong = fallback keyword atas docs-kb/.
# Bila pakai Docker Compose, isi seperti ini:
# RAG_DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
RAG_DATABASE_URL=
PROMPT_VERSION=v1
