# Salin ke .env lalu isi. JANGAN commit .env (sudah di .gitignore).
# LLM: pilih SATU backend dulu (9router ATAU vllm ATAU openrouter ATAU gemini).
# Sejak 27 Nov 2026: 9router — router self-hosted di 9router.marcondol.site.
LLM_BACKEND=9router
LLM_MODEL=for-rag
NINE_ROUTER_API_KEY=
VLLM_BASE_URL=
GEMINI_API_KEY=
# Cadangan (tidak dipakai bila LLM_BACKEND=9router):
OPENROUTER_API_KEY=
# Model default bila LLM_MODEL kosong: 9router -> for-rag
# Embedding untuk pgvector (model 4096-dimensi, default di bawah):
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-8b
# Harga per 1M token (USD) dari provider-mu — untuk cost/request.
# Kosong = 0 = biaya tidak diketahui (bukan nol).
LLM_PRICE_PROMPT_PER_1M=0
LLM_PRICE_COMPLETION_PER_1M=0
# Langfuse self-hosted (isi setelah infra/langfuse jalan).
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# OpenTelemetry Collector (opsional, Minggu 1).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Retrieval: kosong = fallback keyword atas docs-kb/.
# Bila pakai Docker Compose, isi seperti ini:
# RAG_DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
RAG_DATABASE_URL=
PROMPT_VERSION=v1
